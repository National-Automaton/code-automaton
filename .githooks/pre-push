#!/bin/sh
# Block pushes that add or update `main` on the remote.
#
# We standardize on feature branches: every change lands on a `feature/`,
# `fix/`, `docs/`, or `chore/` branch and reaches `main` via a pull request.
#
# Hook input lines look like:
#   <local ref> <local sha> <remote ref> <remote sha>
# An all-zero local sha means the ref is being deleted; skip those.

# Escape hatch for the rare intentional direct push (e.g. an emergency hotfix).
# Use sparingly:  ALLOW_MAIN_PUSH=1 git push ...
if [ "${ALLOW_MAIN_PUSH:-}" = "1" ]; then
  exit 0
fi

protected="main"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/"$protected")
      # Deletions (local_sha is all zeros) are allowed -- e.g. deleting a
      # stale remote main is not something a normal workflow does, but we only
      # guard updates/additions.
      case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
      esac
      echo "" >&2
      echo "refusing to push to '$protected'" >&2
      echo "" >&2
      echo "Direct pushes to '$protected' are disabled. Create a branch and open" >&2
      echo "a pull request instead:" >&2
      echo "" >&2
      echo "    git switch -c feature/<slug>   # or fix/, docs/, chore/" >&2
      echo "    git push -u origin feature/<slug>" >&2
      echo "" >&2
      echo "If you truly must push to '$protected', re-run with:" >&2
      echo "    ALLOW_MAIN_PUSH=1 git push ..." >&2
      echo "" >&2
      status=1
      ;;
  esac
done

exit $status
