# Any OpenAI-compatible endpoint works (DeepSeek, OpenRouter, Groq, Together,
# a local Ollama/llama.cpp server, OpenAI itself, ...).
#
# Replace the placeholder below with your real key. Never commit a real key.
CODA_API_KEY=your-api-key-here

# Optional overrides. Defaults point at DeepSeek.
# CODA_BASE_URL=https://api.deepseek.com
# CODA_MODEL=deepseek-chat

# Where sessions are stored. Default: ~/.coda/sessions
# CODA_SESSIONS_DIR=/path/to/sessions
# CODA_IMAGES_DIR=/path/to/images

# Mouse reporting. Default: on (the wheel scrolls coda's transcript, but the
# terminal's own drag-to-select is disabled -- hold Shift to select).
# Set to "off" to leave the mouse to the terminal so plain drag-to-select
# works; you then scroll with Up/Down, PgUp/PgDn and End.
# CODA_MOUSE=off

# Parallel tool calls. Default: on -- when the model asks for several
# independent read-only tools at once (e.g. five read_file calls), they run
# concurrently. Tools that write files always run in order. Set to "off" to
# run every call strictly in the order the model asked for.
# CODA_PARALLEL_TOOLS=off

# Backwards compatible aliases still work:
# DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL, DEEPSEEK_MODEL, DSC_SESSIONS_DIR

# Context budget, in characters, for the history sent in one request (~4 chars
# per token, so 3,200,000 is roughly 800k tokens). History is trimmed from the
# oldest turn when it would exceed this. Lower it for a model with a smaller
# context window; a single tool's output is separately capped at 200k chars.
# CODA_MAX_CONTEXT_CHARS=3200000

# History compaction. OFF by default.
#
# When on, once history passes 75% of the budget above, the oldest turns are
# replaced with a model-written summary instead of being dropped outright. The
# system prompt and roughly the most recent 20% of the budget stay verbatim.
#
# Worth enabling only on a premium model. The saving scales with input-token
# price: measured over a 285-turn session, compacting saved about $0.30 on
# deepseek-flash but about $223 on claude-sonnet. On a cheap model it discards
# context -- and invalidates the provider's prompt cache -- to save cents.
#
# CODA_COMPACT=on
