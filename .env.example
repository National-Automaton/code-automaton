# Any OpenAI-compatible endpoint works (DeepSeek, OpenRouter, Groq, Together,
# a local Ollama/llama.cpp server, OpenAI itself, ...).
#
# Replace the placeholder below with your real key. Never commit a real key.
CODA_API_KEY=your-api-key-here

# Optional overrides. Defaults point at DeepSeek.
# CODA_BASE_URL=https://api.deepseek.com
# CODA_MODEL=deepseek-chat

# Where sessions are stored. Default: ~/.coda/sessions
# CODA_SESSIONS_DIR=/path/to/sessions

# Backwards compatible aliases still work:
# DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL, DEEPSEEK_MODEL, DSC_SESSIONS_DIR
